#!/bin/sh
# ============================================================================
# .githooks/pre-commit —— 提交前守卫
#
# ⚠️ 本文件的存在理由（2026-09-17 审计，S4）
# ---------------------------------------------------------------------------
# 仓库配置了 `core.hooksPath = .githooks`，但**该目录此前并不存在**，
# 且 `.git/hooks/pre-commit` 也不存在 —— 结果：任何提交都不会触发 hook，
# `.pre-commit-config.yaml` 里的 ruff / 质量门禁 / 分层门禁**长期从未运行**。
# 直接后果：`docs/ui-redesign/v4/_edge_profile_{ov,sv}/**` 共 428 个
# Edge 浏览器凭据文件（Login Data / Local State / Cookies / History）
# 被顺利提交入库，并已推送到远端 main。
#
# 本文件即该缺陷的修复：把 hook 目录补回来，并**补上原先完全缺失的密钥扫描**。
#
# 三层检查（任一失败即拒绝提交）
# ---------------------------------------------------------------------------
#   1) 危险路径守卫 —— 浏览器配置库 / 凭据库 / 私钥文件 一律拒绝入库
#   2) 密钥内容扫描 —— 私钥头、云凭据、口令赋值（含占位符白名单以抑制误报）
#   3) 既有门禁     —— 若 `pre-commit` 可用则运行 .pre-commit-config.yaml
#
# 合法豁免
# ---------------------------------------------------------------------------
#   * 路径豁免：加入 `.githooks/allowlist.txt`（一行一个 glob，`#` 注释）
#   * 内容豁免：同上；本仓库 `scripts/prod_audit/tests/test_self_audit.py`
#     含**脱敏用测试夹具**私钥串，已预置在 allowlist。
#   * 源码内抑制标记（第 2 层，与 CI 侧 scripts/scan_secrets.py 一致）：
#       `# secret-scan:allow`             —— 该行不参与扫描（同行标记）
#       `# secret-scan:allow-next-line`   —— 该行的**下一行**不参与扫描
#     用于「属性名/变量名含 password 等字样但并非凭据」的逐处豁免，
#     比整文件路径豁免更精确。无标记时规则照常生效。
#
# 绕过（仅限紧急，事后必须补跑）
# ---------------------------------------------------------------------------
#   git commit --no-verify
#   ⚠️ 本地 hook 可被绕过，因此 CI 侧必须另有一道独立的扫描（见审计报告行动项）。
# ============================================================================

set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-commit: 无法定位仓库根，跳过检查" >&2
    exit 0
}
cd "$repo_root" || exit 0

allowlist_file=".githooks/allowlist.txt"
fail=0

# 读取豁免 glob（去掉注释与空行）
allow_patterns=""
if [ -f "$allowlist_file" ]; then
    allow_patterns=$(sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$allowlist_file")
fi

is_allowed() {
    [ -z "$allow_patterns" ] && return 1
    printf '%s\n' "$allow_patterns" | while IFS= read -r pat; do
        [ -z "$pat" ] && continue
        # shellcheck disable=SC2254
        case "$1" in $pat) echo "__MATCH__";; esac
    done | grep -q "__MATCH__"
}

# 暂存文件列表（新增/修改/改名；删除不算）
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# ---------------------------------------------------------------------------
# 第 1 层：危险路径守卫
# ---------------------------------------------------------------------------
blocked_paths=""
old_ifs=$IFS
IFS='
'
for f in $staged; do
    [ -z "$f" ] && continue
    if is_allowed "$f"; then continue; fi

    hit=""
    case "$f" in
        # 浏览器配置库（本轮事故正主）
        *_edge_profile_*|*_chrome_profile_*|*_chromium_profile_*|*_firefox_profile_*|*_gecko_profile_*)
            hit="浏览器用户配置目录" ;;
        */Crashpad/*|*/Session\ Storage/*|*/Local\ Storage/*|*/IndexedDB/*|*/Service\ Worker/*)
            hit="浏览器运行态数据目录" ;;
        *.db-journal|*.sqlite-journal)
            hit="数据库 journal 文件" ;;
    esac

    # 精确 basename 命中（浏览器凭据/历史库文件名）
    base=$(basename "$f")
    case "$base" in
        "Login Data"|"Login Data For Account"|"Login Data-journal"|\
        "Local State"|"Cookies"|"Cookies-journal"|"Web Data"|"Web Data-journal"|\
        "History"|"History-journal"|"Vpn Tokens"|"Trust Tokens"|"Affiliation Database")
            hit="浏览器凭据/历史数据库文件" ;;
    esac

    # 私钥 / 凭据文件（允许 *.example / *.sample / *.template）
    # 2026-10-17 审计 AUD-25：移除 `*/docs/*` 豁免——CI 侧 scan_secrets.py 刻意
    # 不豁免 docs/（2026-09-17 的 428 个 Edge 凭据文件事故正发生在 docs/ui-redesign/）。
    # 本地放行、CI 事后报警等于密钥已进远端历史，必须两侧同口径。
    case "$f" in
        *.pem|*.key|*.p12|*.pfx|*id_rsa|*id_ed25519|*.keystore|*.jks)
            case "$f" in
                *.example|*.sample|*.template|*.md) : ;;
                *) hit="私钥/证书文件" ;;
            esac ;;
    esac

    # 真实 .env（不是模板）
    case "$base" in
        ".env"|".env.production"|".env.development"|".env.local"|".env.backup")
            hit="真实环境变量文件（含明文凭据）" ;;
    esac

    if [ -n "$hit" ]; then
        blocked_paths="${blocked_paths}  ✗ $f  —— $hit
"
    fi
done
IFS=$old_ifs

if [ -n "$blocked_paths" ]; then
    echo "" >&2
    echo "━━━ 提交被拒绝：危险路径（第 1 层） ━━━" >&2
    printf '%s' "$blocked_paths" >&2
    echo "" >&2
    echo "处置：git rm -r --cached <路径>，并把模式加入 .gitignore。" >&2
    echo "若确属必要，把路径加入 $allowlist_file 后再提交。" >&2
    echo "参考：2026-09-17 审计 S1（428 个 Edge 凭据文件因本层缺失而入库）。" >&2
    fail=1
fi

# ---------------------------------------------------------------------------
# 第 2 层：密钥内容扫描
# ---------------------------------------------------------------------------
# 高精度模式（宁可漏报，避免误报阻塞正常开发）
secret_patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----|-----BEGIN OPENSSH PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-[A-Za-z0-9]{32,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN (RSA|EC|DSA|PGP) '

# 口令赋值：仅在"看起来是真值"时命中（排除占位符与常见弱口令示例）
# `[A-Za-z]{0,3}` 允许 Python 字符串前缀（r"" / b"" / rb"" 等）——否则 r"..." 形式会漏报。
# 2026-10-24（P1）：关键词允许后缀（SECRET_KEY / API_KEY_ID），右值改为「非空白非引号」，
# 否则含 $ ? ~ ( ) { } | \ 的真口令（"Abc$123456789xyz"）与 SECRET_KEY= 形态整条漏判。
pwd_pattern='([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Pp][Ii][_]?[Kk][Ee][Yy]|[Rr][Ee][Qq][Uu][Ii][Rr][Ee][Pp][Aa][Ss][Ss])[A-Za-z0-9_]*[[:space:]]*[:=][[:space:]]*[A-Za-z]{0,3}["'"'"']?[^[:space:]"'"'"']{12,}'

secret_hits=""
old_ifs=$IFS
IFS='
'
for f in $staged; do
    [ -z "$f" ] && continue
    if is_allowed "$f"; then continue; fi

    # 跳过二进制与超大文件
    case "$f" in
        *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.zip|*.gz|*.7z|*.rar|\
        *.woff|*.woff2|*.ttf|*.eot|*.mp4|*.mp3|*.xlsx|*.docx|*.pptx|*.pyc|\
        *.so|*.dll|*.exe|*.bin|*.dat|*.db|*.sqlite|*.wal|*.shm)
            continue ;;
    esac
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    [ "$size" -gt 2000000 ] && continue

    # ⚠️ 内容必须落到临时文件再扫描。踩过的坑：用 $(git show ":$f") 把内容放进
    # shell 变量时，bash 会剥离 NUL 字节，于是"含 NUL 视为二进制"的判定
    # *(printf '\000')* 退化成 *""* —— 它匹配一切字符串，导致**整层内容扫描被静默跳过**
    # （实测：含伪造私钥的文件被放行）。二进制判定改用 grep -I。
    tmpf=$(mktemp 2>/dev/null) || tmpf="${TMPDIR:-/tmp}/precommit_scan.$$"
    if ! git show ":$f" > "$tmpf" 2>/dev/null; then
        rm -f "$tmpf"
        continue
    fi

    if grep -Iq . "$tmpf" 2>/dev/null; then
        # 源码内抑制标记（与 CI 侧 scripts/scan_secrets.py 语义一致）：
        #   secret-scan:allow            → 该行跳过
        #   secret-scan:allow-next-line  → **下一行**跳过
        # 两条内容规则（私钥/云凭据、口令赋值）都作用于过滤后的内容。
        # ⚠️ 必须先判 next-line：`secret-scan:allow` 是它的前缀，顺序反了会让
        #    inline 规则先命中，next-line 永不生效（CI 侧同理，见 scan_secrets.py）。
        tmpf_scan=$(mktemp 2>/dev/null) || tmpf_scan="${TMPDIR:-/tmp}/precommit_scan_s.$$"
        if ! awk '
            skip_next { skip_next = 0; next }
            /secret-scan:allow-next-line/ { skip_next = 1; next }
            /secret-scan:allow/ { next }
            { print }
        ' "$tmpf" > "$tmpf_scan" 2>/dev/null; then
            # awk 异常时退回全量扫描：宁可误报，不可漏报。
            cp "$tmpf" "$tmpf_scan"
        fi

        # 注意必须用 -e 分隔：模式以 '-' 开头，否则 grep 会把它当选项
        # （实测报 "unknown option -- ---BEGIN ..."，导致扫描静默失效）
        if grep -Eq -e "$secret_patterns" "$tmpf_scan"; then
            secret_hits="${secret_hits}  ✗ $f  —— 命中私钥/云凭据特征
"
        else
            # 逐步收窄误报（本仓实测踩到两次，故留注释）：
            #   ① 占位符样式（<...> / YOUR_ / changeme / example ...）
            #   ② **右侧是表达式而非字面量**：如 `password = userinfo.split(":", 1)[1]`
            #      —— 它是解析 DSN 的代码，不是硬编码凭据。判据：运算符后紧跟
            #      「标识符 + ( 或 [」，即函数调用/下标取值。
            #      （若不放宽，本仓自己的 scripts/diag/runtime_mode_probe.py 会被拦住）
            #   ③ 同 ② 的变体：右侧是**布尔合并表达式**，如
            #      `effective_encryption_password = encrypt_password or get_...()`
            #      —— 仍是变量合并而非字面量，但 `or` 打断了 ② 的「标识符+(」判据。
            #      判据：标识符 + or/and + 标识符（可带调用）。
            #      （若不放宽，备份加密决策行会被反复拦住；该行右侧无任何字面值）
            # ⚠️ 必须用 -o 提取**匹配片段**而非整行：第 ④ 层按「右值是否带引号」判定，
            #    若拿整行去判，形如 `access_token=access_token, token_type="bearer"`
            #    的行会因为右侧另有一个带引号字面量而整行放行（实测踩到）。
            pwd_matches=$(grep -Eio -e "$pwd_pattern" "$tmpf_scan" | \
                grep -Eiv -e '(<[^>]+>|YOUR_|CHANGE_?ME|changeme|placeholder|example|xxxx|dummy|fake|testkey|your[-_])' | \
                grep -Eiv -e '[:=][[:space:]]*[A-Za-z0-9_.]*([\(\[]|[[:space:]]+(or|and)[[:space:]]+[A-Za-z0-9_.]*[\(\[]?)')

            # ④ Python 专属收窄（2026-09-24）：`.py` 里**不带引号的右值必然是表达式**
            #    （属性读取 / 变量引用 / 函数调用），不可能是硬编码字面量密钥。
            #    缺少这一层会把纯引用误判为凭据 —— 实测 `api/v1/endpoints/auth.py` 的
            #    `password = data.password`、`access_token=access_token` 与
            #    `services/backup/restore.py` 的 `decrypt_password=decrypt_password`
            #    三处被拦，而它们**本就在 HEAD 中**（既有已推送代码），
            #    导致任何触及这两个文件的提交都无法通过。
            #    允许 f"" / r"" / b"" / rb"" 等前缀（Python 硬编码密钥必然是带引号的字面量）。
            #    注意：本层只收窄「口令赋值」规则；私钥头 / 云凭据特征（$secret_patterns）
            #    对所有文件类型仍然照常生效，不受此处影响。
            #
            # 2026-10-02 补 .ts/.tsx/.vue/.js（原先只有 .py，导致同款误报在 TS 里无法豁免）：
            #    实测 `frontend-vite/src/views/login/useLogin.ts` 的 `password: form.password,`
            #    **逐字已经在 HEAD 中**，却让任何触及该文件的提交都被拦，只能加行内
            #    `// secret-scan:allow` 绕过。判据用「右值是纯标识符路径则排除」——
            #    比 .py 的「必须带引号」更强（连函数调用 `getPass()` 一并排除），
            #    且无需在 shell 里内嵌反引号；`password: 'hunter2…'` / `` `hunter2…` ``
            #    这类字面量仍照常命中。
            case "$f" in
                *.py)
                    pwd_matches=$(printf '%s\n' "$pwd_matches" \
                        | grep -E '[:=][[:space:]]*[A-Za-z]{0,3}["'\'']' || true)
                    ;;
                *.ts|*.tsx|*.vue|*.js|*.mjs|*.cjs)
                    pwd_matches=$(printf '%s\n' "$pwd_matches" \
                        | grep -Ev '[:=][[:space:]]*[A-Za-z_$][A-Za-z0-9_$.]*$' || true)
                    ;;
            esac

            if [ -n "$pwd_matches" ]; then
                secret_hits="${secret_hits}  ✗ $f  —— 疑似明文口令/密钥赋值
"
            fi
        fi
    fi
    rm -f "$tmpf" "$tmpf_scan"
done
IFS=$old_ifs

if [ -n "$secret_hits" ]; then
    echo "" >&2
    echo "━━━ 提交被拒绝：疑似凭据（第 2 层） ━━━" >&2
    printf '%s' "$secret_hits" >&2
    echo "" >&2
    echo "处置：改用环境变量/密钥管理注入，勿把真值写进版本库。" >&2
    echo "若为脱敏测试夹具，把路径加入 $allowlist_file。" >&2
    fail=1
fi

# ---------------------------------------------------------------------------
# 第 3 层：既有门禁（.pre-commit-config.yaml）
# ---------------------------------------------------------------------------
# 解析顺序：项目 venv → PATH。两个理由缺一不可：
#   · pre-commit 装在项目 venv（.venv/Scripts/pre-commit.exe），git-bash 的 PATH 通常看不到它，
#     只认 `command -v` 会让第 3 层永远走降级分支；
#   · .pre-commit-config.yaml 的 local hook 是 `entry: python scripts/quality_gate.py`，走 PATH
#     上的 python。若落到**系统** Python，门禁的 pip-audit 项会混扫整机所有项目的依赖 →
#     直接判 FAIL → 每次提交都被挡（2026-10-01 实测 172 条漏洞）。故用 venv 的 bin 前缀 PATH。
venv_bin="$(pwd)/.venv/Scripts"
pc_bin=""
if [ -x "$venv_bin/pre-commit.exe" ]; then
    pc_bin="$venv_bin/pre-commit.exe"
elif [ -x "$venv_bin/pre-commit" ]; then
    pc_bin="$venv_bin/pre-commit"
elif command -v pre-commit >/dev/null 2>&1; then
    pc_bin="pre-commit"
fi

# 挑一个**真能跑**的 ruff。
# 只判 `-x` 不够：本机 .venv 曾被 Low 完整性标签打坏，ruff.exe 能跑 `--version`
# 却读不了 ruff.toml（OS Error 5），随后 `check` 以退出码 2 失败 —— 钩子把「跑不起来」
# 当成「代码违规」，提交被永久挡死（2026-10-21 实测）。探针必须同时验证「能启动」和
# 「能读仓库配置」，所以走一次真实的 stdin 检查而不是 --version。
find_ruff() {
    for cand in "$(pwd)/.venv/Scripts/ruff.exe" "$(pwd)/.venv/Scripts/ruff" ruff; do
        if [ -x "$cand" ] || command -v "$cand" >/dev/null 2>&1; then
            if "$cand" check --stdin-filename _probe.py - </dev/null >/dev/null 2>&1; then
                printf '%s' "$cand"
                return 0
            fi
        fi
    done
    return 1
}

# 判「将要提交的那份内容」（索引里的 blob）是否 ruff 干净。
# 为什么不用工作区文件：并发会话会在提交期间写工作区（AGENTS §6.1-5），
# 工作区内容既可能不是将要提交的内容，也可能已被 pre-commit 的 ruff 钩子改过
# —— 只有索引里的 blob 才是真正会进这次提交的东西。
check_staged_ruff_clean() {
    ruff_bin="$(find_ruff)" || {
        echo "pre-commit: 未找到可用的 ruff，暂存内容 ruff 检查跳过（CI 会兜底）" >&2
        return 0
    }
    old_ifs4=$IFS
    IFS='
'
    for f in $staged; do
        case "$f" in
            *.py)
                git show ":$f" 2>/dev/null \
                    | "$ruff_bin" check --stdin-filename "$f" - >/dev/null 2>&1
                ruff_rc=$?
                if [ "$ruff_rc" -eq 2 ]; then
                    # 退出码 2 = ruff 自身故障（配置读不了、参数错），不是代码违规。
                    echo "" >&2
                    echo "━━━ 提交被拒绝：ruff 运行失败（退出码 2，环境故障而非代码违规）━━━" >&2
                    echo "诊断：$ruff_bin check $f" >&2
                    fail=1
                elif [ "$ruff_rc" -ne 0 ]; then
                    echo "" >&2
                    echo "━━━ 提交被拒绝：暂存内容有 ruff 违规（ruff --fix 后请重新 git add）━━━" >&2
                    "$ruff_bin" check "$f" 1>&2 2>/dev/null || true
                    fail=1
                fi
                ;;
        esac
    done
    IFS=$old_ifs4
}

# 退而求其次：把 .pre-commit-config.yaml 的两项检查在本地直接跑掉
# （ruff --fix + 质量门禁），不依赖 pre-commit 的环境 bootstrap。
# ⚡ 性能门：质量门禁是**全仓扫描**（AST + 前端组件），实测在 Windows/git-bash 下
#    会让一次提交多花数十秒。而它只检查 .py / .vue，因此仅当暂存里确实有这两类文件时
#    才运行——纯文档/配置提交直接跳过，避免把提交变成慢操作而诱发 --no-verify 滥用。
#    例外：暂存了 scripts/gate_baseline.json 时**必须**跑（2026-10-17 审计 F3-7：
#    基线可被手工上调 → 新增违规被洗进基线 → CI 恒绿；纯基线提交不含 .py/.vue，
#    原先连降级门禁都不触发）。基线提交只跑**基线检查**（不扫描全仓），保持提交够快。
#    force_gate=1：调用方明确知道「本次没有门禁结论」（pre-commit 崩了）→ 无条件跑全量门禁。
run_degraded_gate() {
    force_gate="${1:-0}"
    need_gate=0
    need_baseline=0
    py_files=""
    old_ifs2=$IFS
    IFS='
'
    for f in $staged; do
        case "$f" in
            *.py|*.vue) need_gate=1 ;;
            scripts/gate_baseline.json) need_baseline=1 ;;
        esac
        case "$f" in
            *.py) py_files="$py_files $f" ;;
        esac
    done
    IFS=$old_ifs2
    [ "$force_gate" = "1" ] && need_gate=1

    if [ "$need_gate" -eq 0 ] && [ "$need_baseline" -eq 0 ]; then
        echo "pre-commit: 暂存内容不含 .py/.vue 与 scripts/gate_baseline.json，跳过代码质量门禁（第 3 层）" >&2
        return 0
    fi

    # ---- ruff：对齐 .pre-commit-config.yaml 的 ruff 钩子（--fix，仅 .py）----
    # 与 pre-commit 同语义：改动了文件即判失败（需重新 `git add` 再提交），
    # 而不是「修完就当通过」——否则自动修复会静默进入工作区却没进这次提交。
    # 注意 ruff --fix 修完返回 0，故不能只看退出码，要比对文件哈希是否变化。
    ruff_bin="$(find_ruff)" || ruff_bin=""
    if [ -n "$py_files" ] && [ -n "$ruff_bin" ]; then
        ruff_before="$(git hash-object -- $py_files 2>/dev/null)"
        "$ruff_bin" check --fix $py_files >/dev/null 2>&1
        ruff_after="$(git hash-object -- $py_files 2>/dev/null)"
        if [ "$ruff_before" != "$ruff_after" ]; then
            echo "" >&2
            echo "━━━ 提交被拒绝：ruff 已自动修复下列文件，请重新暂存后提交 ━━━" >&2
            "$ruff_bin" check $py_files 1>&2 2>/dev/null || true
            fail=1
            return 0
        fi
        "$ruff_bin" check $py_files >/dev/null 2>&1
        ruff_rc=$?
        if [ "$ruff_rc" -eq 2 ]; then
            echo "" >&2
            echo "━━━ 提交被拒绝：ruff 运行失败（退出码 2，环境故障而非代码违规）━━━" >&2
            echo "诊断：$ruff_bin check $py_files" >&2
            fail=1
        elif [ "$ruff_rc" -ne 0 ]; then
            "$ruff_bin" check $py_files 1>&2 2>/dev/null || true
            echo "" >&2
            echo "━━━ 提交被拒绝：ruff 未通过（第 3 层降级模式） ━━━" >&2
            fail=1
        fi
    fi

    # 暂存内容（索引 blob）必须自身 ruff 干净 —— 判的是「真正会进这次提交的东西」。
    # 与并发会话写工作区无关，也不会因 pre-commit 的 ruff 钩子已把工作区改干净而漏判。
    check_staged_ruff_clean

    [ -f "scripts/quality_gate.py" ] || return 0

    py=""
    # 解释器优先级：**项目 venv** → PATH → 本机已知解释器绝对路径
    # （git-bash 的 PATH 常常找不到 Windows Python，故显式兜底绝对路径）
    #
    # 为什么 venv 必须优先：门禁的 pip_audit 项执行的是 `sys.executable -m pip_audit`，
    # 扫的是**该解释器自己的 site-packages**，而不是项目声明的依赖。用系统 Python 会把
    # 这台机器上所有项目的依赖混在一起扫（2026-10-01 实测 25 个包 172 条漏洞）→
    # 直接判 FAIL → 挡掉一切提交；venv 与本项目依赖同源，口径才对。
    for cand in ".venv/Scripts/python.exe" \
        "$(pwd)/.venv/Scripts/python.exe" \
        python python3 py \
        "/c/Users/Administrator/AppData/Local/Programs/Python/Python313/python.exe" \
        "/c/Users/Administrator/.workbuddy/binaries/python/versions/3.13.12/python.exe"; do
        if command -v "$cand" >/dev/null 2>&1 || [ -x "$cand" ]; then
            # 文件存在 ≠ 能跑。本机 .venv 曾被 Low 完整性标签打坏：python.exe 打印
            # "failed to open pyvenv.cfg" 后以 107 退出，一行代码都没执行（用管道时
            # $? 会被下游命令覆盖，肉眼很容易读成 0）。只看 `-x` 会选中坏解释器，
            # 随后门禁「跑不起来」被误判成「检查不通过」，提交被永久挡死（2026-10-21
            # 实测）。判据必须是 stdout 里的哨兵串——坏解释器的 stdout 是空的。
            if [ "$("$cand" -c "import sys; sys.stdout.write('PYOK')" 2>/dev/null)" = "PYOK" ]; then
                py="$cand"
                break
            fi
        fi
    done
    if [ -z "$py" ]; then
        echo "pre-commit: 未找到可用 Python，代码质量门禁未运行（请人工补跑）" >&2
        echo "pre-commit: 建议 pip install pre-commit 以恢复完整门禁" >&2
        return 0
    fi

    # ---- 基线棘轮守卫（2026-10-17 审计 F3-7）----
    # 参考基线取 HEAD（= 本次提交的父提交）：本次提交把基线往上调会被拦下。
    # 只跑基线检查（不扫全仓），纯基线提交也够快。
    if [ "$need_baseline" -eq 1 ]; then
        if ! GATE_BASELINE_REF=HEAD "$py" scripts/quality_gate.py --baseline-check >/dev/null 2>&1; then
            echo "" >&2
            echo "━━━ 提交被拒绝：门禁基线被上调（第 3 层） ━━━" >&2
            echo "基线棘轮只允许下调：上调会把新增违规洗进基线，门禁随之恒绿。" >&2
            echo "诊断：GATE_BASELINE_REF=HEAD $py scripts/quality_gate.py --baseline-check" >&2
            echo "处置：先修掉新增违规；确需上调用 --update-baseline --force 并在提交信息写明理由，" >&2
            echo "      或本次提交临时设 GATE_ALLOW_BASELINE_RAISE=1。" >&2
            fail=1
        fi
    fi

    if [ "$need_gate" -eq 0 ]; then
        return 0
    fi

    if ! "$py" scripts/quality_gate.py >/dev/null 2>&1; then
        echo "" >&2
        echo "━━━ 提交被拒绝：代码质量门禁未通过（第 3 层降级模式） ━━━" >&2
        echo "诊断：$py scripts/quality_gate.py" >&2
        fail=1
    fi
}

if [ -n "$pc_bin" ]; then
    # hook 环境缓存放仓内（未被显式设置时）。
    # 本机 Python 写不了 C:\Users\Administrator\.cache —— ACL 让它拿 EACCES，SQLite 报
    # "attempt to write a readonly database"，而 pre-commit 的默认 PRE_COMMIT_HOME 正是那里，
    # 于是第 4 层永远起不来（2026-10-10 实测：普通 PowerShell 与关沙箱后同样复现，非沙箱问题）。
    # 仓内目录已实测可写；CI/其它机器若已设 PRE_COMMIT_HOME 则尊重原值。
    if [ -z "${PRE_COMMIT_HOME:-}" ]; then
        # 必须用 Windows 形态路径（$repo_root 来自 git rev-parse，形如 D:/erp_system）。
        # pre-commit 是 Windows 进程：`$(pwd)` 的 POSIX 形态（/d/erp_system）会被它当成
        # 「当前盘符下的相对路径」→ D:\d\erp_system\… → makedirs 在 D:\d 处 PermissionError。
        # 平时靠 MSYS 对子进程环境变量的自动路径转换兜住，但 MSYS_NO_PATHCONV=1 下不转换，
        # pre-commit 直接起不来（2026-10-10 实测）。用 $repo_root 则与 MSYS 设置无关。
        PRE_COMMIT_HOME="$repo_root/.pre-commit-home"
    fi
    export PRE_COMMIT_HOME
    mkdir -p "$PRE_COMMIT_HOME" 2>/dev/null

    # 先捕获输出再回显：需要据此区分「hook 真的失败」与「pre-commit 自身崩了」。
    pc_out="$(PATH="$venv_bin:$PATH" "$pc_bin" run --hook-stage pre-commit --color=never 2>&1)"
    pc_rc=$?
    printf '%s\n' "$pc_out" >&2

    if [ "$pc_rc" -eq 0 ]; then
        :
    elif [ "$pc_rc" -eq 1 ] \
         && printf '%s' "$pc_out" | grep -q 'files were modified by this hook' \
         && ! printf '%s' "$pc_out" | grep -q -- '- exit code:'; then
        # 「hook 运行期间工作区被改写」，且**没有任何 hook 以非零码退出**
        # （pre-commit 的输出里有 "- exit code: N" 才代表 hook 自身失败；
        #   缺这一行 ⇒ 跑完的 hook 全部退出码为 0）。
        # pre-commit 这条判定是「跑 hook 前后的**全仓 diff**比对」——本机有并发
        # 会话在写工作区（AGENTS §6.1-5），第三方写入会被误记成「hook 改动了文件」
        # → 提交被永久挡死（2026-10-20 实测连续两次，第二次同批 6 个文件被写）。
        # 门禁结论本身是有效的：always_run 的 quality-gate hook 已跑完全量扫描并
        # 退出 0（跑 hook 期间工作区被 pre-commit stash 成"仅暂存内容"，扫的就是
        # 这次要提交的东西）。此处只复核「将要提交的 blob」ruff 干净。
        echo "pre-commit: 检出「hook 运行期间工作区被改写」（并发会话写入），按暂存内容复核" >&2
        check_staged_ruff_clean
    elif [ "$pc_rc" -eq 1 ] && printf '%s' "$pc_out" | grep -q 'hook id:'; then
        # 真失败：pre-commit 会逐个列出失败的 hook（"- hook id: ruff"）。
        echo "" >&2
        echo "━━━ 提交被拒绝：既有门禁未通过（第 3 层） ━━━" >&2
        echo "（ruff / 代码质量门禁 / 分层门禁，见 .pre-commit-config.yaml）" >&2
        fail=1
    else
        # 工具跑不起来，**不等于**门禁失败。已知三种：
        #   · 退出码 3 = pre-commit 自身意外错误（hook 环境未就绪 / 配置错误）；
        #   · 退出码 130 = 中断；
        #   · 退出码 1 但输出里**没有** "- hook id:" = 崩溃在错误处理里（实测：缓存目录
        #     ~/.cache/pre-commit 对沙箱身份只读时，PermissionError 在错误处理阶段再抛，
        #     Python 以 1 退出，与「hook 失败」撞码）。
        # 三种都回退到降级门禁；若一并拦截，沙箱/离线环境会把所有提交挡死。
        # force_gate=1：这条路径**没有任何门禁结论**（pre-commit 没跑成），
        #   故无条件跑全量门禁，不能按「暂存无 .py/.vue」跳过。
        echo "pre-commit: 未能运行 hook（退出码 $pc_rc），回退到降级门禁" >&2
        echo "pre-commit: hook 环境未就绪；本仓 hook 均为本地、无需联网，可试：$pc_bin run --all-files" >&2
        run_degraded_gate 1
    fi
else
    echo "pre-commit: 未安装 pre-commit，跳过第 3 层门禁（ruff/质量门禁/分层门禁）" >&2
    echo "pre-commit: 建议安装以恢复完整保护：pip install pre-commit" >&2
    run_degraded_gate
fi

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "提交已取消。确需紧急绕过请用：git commit --no-verify（事后必须补跑上述检查）。" >&2
    exit 1
fi

exit 0
