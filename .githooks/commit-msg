#!/usr/bin/env bash
# commit-msg hook - 强制 UTF-8 提交信息
#
# 背景: 历史提交中出现过 GBK 编码终端写入的乱码消息（如 "淇敼" 实为 GBK 的"修改"）。
# 本 hook 在提交前校验消息编码，从源头阻止非 UTF-8 消息再次入库。
#
# 规则:
#   1. 提交信息必须是合法 UTF-8（严格解码，可识别 GBK 等多字节非 UTF-8 序列）
#   2. 不得包含 Unicode 替换字符 U+FFFD（乱码已损坏的标志）
#
# 用法: git 自动调用，或手动测试: bash .githooks/commit-msg <提交信息文件>

MSG_FILE="${1:?commit-msg hook: 缺少提交信息文件参数}"

# 选择可用的 Python 解释器（优先 python，兼容 python3 / py）
PYTHON=""
for cand in python python3 py; do
    if command -v "$cand" >/dev/null 2>&1; then
        PYTHON="$cand"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "commit-msg hook: 未找到 Python 解释器，跳过编码校验（仅警告）" >&2
    exit 0
fi

"$PYTHON" - "$MSG_FILE" <<'PYEOF'
import sys

with open(sys.argv[1], 'rb') as f:
    data = f.read()

# 规则 1: 严格 UTF-8 解码（GBK 等非 UTF-8 多字节序列会在此失败）
try:
    data.decode('utf-8')
except UnicodeDecodeError:
    sys.exit(1)

# 规则 2: 不含替换字符 U+FFFD
if b'\xef\xbf\xbd' in data:
    sys.exit(2)
PYEOF
rc=$?

if [ "$rc" -eq 0 ]; then
    exit 0
fi

case $rc in
    1) echo "commit-msg hook: 提交信息不是合法 UTF-8（疑似来自 GBK 编码终端），已拒绝提交" >&2 ;;
    2) echo "commit-msg hook: 提交信息包含乱码替换字符 U+FFFD（�），已拒绝提交" >&2 ;;
    *) echo "commit-msg hook: 提交信息编码校验失败（python 退出码 $rc），已拒绝提交" >&2 ;;
esac
echo "提示: 请使用 UTF-8 编码的终端或编辑器重新填写提交信息" >&2
exit 1
