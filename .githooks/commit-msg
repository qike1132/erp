#!/bin/sh
# ============================================================================
# .githooks/commit-msg —— 剥掉**第三方 AI 工具**的署名尾行
# ============================================================================
# 背景：本仓曾被 15+ 个 AI 编程工具污染（目录清单见 AGENTS.md §7）。
# 2026-10-03 发现 Codebuff 在 **12 个提交**（2026-08-11 起）里写入
#   `🤖 Generated with Codebuff`
#   `Co-Authored-By: Codebuff <noreply@codebuff.com>`
# 与本仓的 AI 痕迹治理意图相悖。
#
# 处置：**就地剥掉**（而不是让提交失败）—— 这样无论哪个工具提交，历史都不再被污染，
# 也不会阻断任何工具的正常工作流。
#
# ⚠️ **故意不剥 Claude 的署名**：本仓的协作流程明确使用 Claude Code，
#    `Co-Authored-By: Claude ...` 是有意保留的（与 Codebuff 这类未申报的工具不同）。
#    若要连它一起剥，把 `Claude` 加进下面的 tools 列表即可。
#
# 绕过（仅限紧急）：git commit --no-verify
# ----------------------------------------------------------------------------
msg_file="$1"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

# 已知的第三方 AI 工具（大小写不敏感）。
# ⚠️ 刻意**不含 `Cody`**：它既是 Sourcegraph Cody 的产品名，也是常见人名 ——
#    实测 `Co-Authored-By: Cody <cody@example.com>` 会被误剥。宁可漏剥一个工具，
#    不要静默丢弃人类协作者的归属。
tools='Codebuff|Cursor|Copilot|Windsurf|Aider|Devin|Tabnine|Continue|Qodo|Trae|Qoder|Cline|Roo'

tmp="$(mktemp)" || exit 0

# 1) 删「(🤖) Generated with <tool> (🤖)」整行
# 2) 删「Co-Authored-By: <tool> <...>」整行
# 只匹配列表内的工具，避免误伤人类协作者的 Co-Authored-By。
sed -E \
  -e "/^[[:space:]]*(🤖[[:space:]]*)?Generated with[[:space:]]*(${tools})([[:space:]]*🤖)?[[:space:]]*$/Id" \
  -e "/^[[:space:]]*Co-Authored-By:[[:space:]]*(${tools})[[:space:]]*<[^>]*>[[:space:]]*$/Id" \
  "$msg_file" \
| awk '{ line[NR] = $0 } $0 ~ /[^[:space:]]/ { last = NR }
       END { for (i = 1; i <= last; i++) print line[i] }' > "$tmp"

# ⚠️ 绝不把**非空**的提交信息覆盖成**空**：sed/awk 一旦失败（如 BSD sed 不认 `I` 标志）
# 会产出空输出，此时若直接 cp 就会把提交信息抹成 0 字节 → git 报 "empty commit message"。
# 实测：sed 报错时 msg_file 由 36 字节变 0 字节。故只在「新内容非空」或「原信息本就为空」时才覆盖。
if { [ -s "$tmp" ] || [ ! -s "$msg_file" ]; } && ! cmp -s "$msg_file" "$tmp"; then
    cp "$tmp" "$msg_file"
    echo "commit-msg: 已剥掉第三方 AI 工具署名尾行（AGENTS.md §7 AI 痕迹治理）" >&2
fi
rm -f "$tmp"
exit 0
