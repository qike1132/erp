# =============================================================================
# 生产环境配置**参考清单**（.env.production.example）
# -----------------------------------------------------------------------------
# ⛔ 重要纠正（2026-09-17 审计 M1）——本文档此前引导了错误做法，务必先读：
#
#   本应用**从不加载 .env.production**。权威配置只有 `.env` 一个文件：
#     - fastapi_app/core/config.py:10   load_dotenv(override=False)   ← 只找 .env
#     - fastapi_app/core/config.py:279  SettingsConfigDict(env_file=".env")
#   因此「复制本文件为 .env.production」**不会产生任何效果**，只会让人误以为配置已生效。
#
#   ⚠️ 更危险的是：scripts/switch_env.py production 曾把 .env.production **覆盖写**到 .env。
#      该路径当前已被显式禁用（copy 前 return False），但请勿依赖它。
#
#   正确做法：把需要覆盖的值写进仓库根的 **.env**（或由部署环境以真实环境变量注入，
#             环境变量优先级高于 .env，因为 load_dotenv 使用 override=False）。
#   本文件的用途：仅作为「生产必须配置哪些键」的**清单**，不参与任何加载。
#
# 另：本文件刻意保持可提交（它是模板）。真实凭据一律不得写入。
# =============================================================================

# =============================================================================
# 【生产启动阻断项】以下键缺失/不合规会让应用**直接启动失败**（config.py:196-245 强校验）
# =============================================================================
# APP_ENV 判定为 production 的**前提**；不设则按开发环境宽松校验。
APP_ENV=production

# ⛔ 必填。缺失、为空、或含 "*" → RuntimeError，应用拒绝启动。
#    必须填具体域名/主机字面量，逗号分隔。内网部署示例：192.168.0.95,erp.lan
#    注意：该项同时被 TrustedHostMiddleware 与 CSRF Origin/Referer 校验使用。
ALLOWED_HOSTS=<必填：逗号分隔的具体主机名，禁止为空或 *>

# ⛔ 必填且生产环境长度必须 >= 32 字符（否则 RuntimeError）。
#    生成：openssl rand -hex 32
SECRET_KEY=<必填：>=32 字符的高强度随机密钥>

# ⛔ 生产环境 CORS 允许来源**不得包含 "null"**（沙箱 iframe 逃逸风险），否则 RuntimeError。
#    内网明文 HTTP 时须显式放行内网 IP 字面量（用 hostname 精确比对，禁用前缀匹配）。
BACKEND_CORS_ORIGINS=http://192.168.0.95:3000

# 仅当 ALGORITHM 取 RS256/ES256 时为必填：两个路径都必须指向**真实存在**的文件，
# 否则 RuntimeError。私钥不得提交仓库。
# ALGORITHM=HS256
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=

# =============================================================================
# 【运行参数】有默认值，但生产需显式确认
# =============================================================================
# uvicorn worker 数。⚠️ 真实生效来源是 **.env**（由 prod_runner._load_dotenv 加载）；
# NSSM 服务参数 AppEnvironmentExtra 里的同名变量**不会生效**（见审计 H7）。
# 未配置时代码回退 max(1, min(4, cpu_count))。
UVICORN_WORKERS=8

# =============================================================================
# 【数据库 / Redis】以下为参考值
# ⚠️ 连接串写 127.0.0.1 而非 localhost：Windows 下 localhost 会解析出 ::1，而 Redis/PG
#    常只监听 IPv4 回环，连 ::1 会超时（2026-10-10 生产备份因此被 fail-closed 拒跑）。
# =============================================================================

# 数据库配置
DB_TYPE=postgresql

# PostgreSQL 配置
# ⚠️ 生产环境禁止使用 root 账户和弱密码！
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=erp_app
# 敏感值：通过密钥管理服务注入，禁止在文件中硬编码
DB_PASSWORD=<从密钥管理服务注入>
DB_NAME=erp_system

# 数据库连接池配置
DB_POOL_SIZE=12
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=5
SQL_ECHO=false

# Flask 安全配置
# ⚠️ 生产环境 SECRET_KEY 必须与开发环境不同！
# 更换后需重启服务，旧会话将失效
# 敏感值：通过密钥管理服务注入，禁止在文件中硬编码
SECRET_KEY=<从密钥管理服务注入>

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 敏感值：通过密钥管理服务注入，禁止在文件中硬编码
REDIS_PASSWORD=<从密钥管理服务注入>

# Redis 独立实例拆分（本地单实例可按数据库号逻辑拆分）
# 密码由部署环境注入，此处仅示连接串结构
REDIS_URL=redis://:<从密钥管理服务注入>@127.0.0.1:6379/0
REDIS_CACHE_URL=redis://:<从密钥管理服务注入>@127.0.0.1:6379/0
REDIS_BROKER_URL=redis://:<从密钥管理服务注入>@127.0.0.1:6379/1
REDIS_RESULT_URL=redis://:<从密钥管理服务注入>@127.0.0.1:6379/2

# 限流存储 (Redis 不可用时自动降级为内存存储)
LIMITER_STORAGE_URI=redis://:<从密钥管理服务注入>@127.0.0.1:6379/0

# 对象存储配置（P2-1）
# 生产环境应使用 MinIO/S3，本地演示可保留 local
STORAGE_TYPE=local
S3_ENDPOINT=
S3_BUCKET=erp-uploads
# 敏感值：使用 S3/MinIO 时由密钥管理服务注入
S3_ACCESS_KEY=<从密钥管理服务注入>
S3_SECRET_KEY=<从密钥管理服务注入>
S3_REGION=us-east-1
S3_PUBLIC_URL=

# 生产环境配置
# 2026-09-29：已移除 FLASK_ENV / FLASK_DEBUG —— 二者是 Flask 时代遗留键，全仓零消费方
# （ast 全仓扫描：FLASK_DEBUG 0 处；FLASK_ENV 仅 tests/performance/test_performance.py:178
#  一处 os.environ 赋值，且该文件已整体 pytest.mark.skip）。
# FastAPI 侧对应的调试开关是 FASTAPI_DEBUG。
# 注意：本机 .env / .env.production 里可能仍残留这两个键（未跟踪、已被 .gitignore 覆盖），
# 属无害残留，需运维手工清理；本模板不再提供它们。

# Nginx 代理模式（1 = Nginx 反向代理，0 = 直连模式）
NGINX_PROXY=0

# 生产环境特定配置
SESSION_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https

# JWT 配置（生产环境使用 ES256 = ECDSA P-256 非对称签名，私钥仅服务端持有）
JWT_ALGORITHM=ES256
JWT_PRIVATE_KEY_PATH=config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=config/jwt/public.pem

# CORS 配置
# 生产优先使用 HTTPS 域名（https 源一律放行）。
# 纯内网部署（如 http://192.168.0.95:3000）需显式列出：明文 HTTP 仅放行
# localhost / 回环 / 内网 IP 字面量，公网明文 HTTP 一律拒收。
# 规则见 fastapi_app/core/config.py::_is_production_allowed_origin
CORS_ORIGINS=http://localhost:5002,http://localhost:3000
# 内网示例（按实际网段替换）：
# CORS_ORIGINS=https://erp.example.com,http://localhost:3000,http://192.168.0.95:3000

# FastAPI 服务绑定配置
# 生产环境默认绑定 127.0.0.1（仅本机回环），开发环境默认绑定 :: （所有接口）
# 可通过 FASTAPI_HOST 显式覆盖；APP_ENV=prod 时回退默认值为 127.0.0.1
APP_ENV=prod
FASTAPI_HOST=127.0.0.1