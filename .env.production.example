# =============================================================================
# 生产环境配置模板（.env.production.example）
# -----------------------------------------------------------------------------
# 用途：作为生产环境配置的参考模板，可安全提交到版本控制。
#       实际生产凭据请通过密钥管理服务/环境变量注入，切勿写入本文件。
# 使用：复制为 .env.production 并按需调整非敏感配置；敏感值由部署环境注入。
# =============================================================================

# 数据库配置
DB_TYPE=postgresql

# PostgreSQL 配置
# ⚠️ 生产环境禁止使用 root 账户和弱密码！
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_app
# 敏感值：通过密钥管理服务注入，禁止在文件中硬编码
DB_PASSWORD=<从密钥管理服务注入>
DB_NAME=erp_system

# 数据库连接池配置
DB_POOL_SIZE=12
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=5
SQL_ECHO=false

# Flask 安全配置
# ⚠️ 生产环境 SECRET_KEY 必须与开发环境不同！
# 更换后需重启服务，旧会话将失效
# 敏感值：通过密钥管理服务注入，禁止在文件中硬编码
SECRET_KEY=<从密钥管理服务注入>

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# 敏感值：通过密钥管理服务注入，禁止在文件中硬编码
REDIS_PASSWORD=<从密钥管理服务注入>

# Redis 独立实例拆分（本地单实例可按数据库号逻辑拆分）
# 密码由部署环境注入，此处仅示连接串结构
REDIS_URL=redis://:<从密钥管理服务注入>@localhost:6379/0
REDIS_CACHE_URL=redis://:<从密钥管理服务注入>@localhost:6379/0
REDIS_BROKER_URL=redis://:<从密钥管理服务注入>@localhost:6379/1
REDIS_RESULT_URL=redis://:<从密钥管理服务注入>@localhost:6379/2

# 限流存储 (Redis 不可用时自动降级为内存存储)
LIMITER_STORAGE_URI=redis://:<从密钥管理服务注入>@localhost:6379/0

# 对象存储配置（P2-1）
# 生产环境应使用 MinIO/S3，本地演示可保留 local
STORAGE_TYPE=local
S3_ENDPOINT=
S3_BUCKET=erp-uploads
# 敏感值：使用 S3/MinIO 时由密钥管理服务注入
S3_ACCESS_KEY=<从密钥管理服务注入>
S3_SECRET_KEY=<从密钥管理服务注入>
S3_REGION=us-east-1
S3_PUBLIC_URL=

# 生产环境配置
FLASK_ENV=production
FLASK_DEBUG=0

# Nginx 代理模式（1 = Nginx 反向代理，0 = 直连模式）
NGINX_PROXY=0

# 生产环境特定配置
SESSION_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https

# JWT 配置（生产环境使用 ES256 = ECDSA P-256 非对称签名，私钥仅服务端持有）
JWT_ALGORITHM=ES256
JWT_PRIVATE_KEY_PATH=config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=config/jwt/public.pem

# CORS 配置
# 生产优先使用 HTTPS 域名（https 源一律放行）。
# 纯内网部署（如 http://192.168.0.95:3000）需显式列出：明文 HTTP 仅放行
# localhost / 回环 / 内网 IP 字面量，公网明文 HTTP 一律拒收。
# 规则见 fastapi_app/core/config.py::_is_production_allowed_origin
CORS_ORIGINS=http://localhost:5002,http://localhost:3000
# 内网示例（按实际网段替换）：
# CORS_ORIGINS=https://erp.example.com,http://localhost:3000,http://192.168.0.95:3000

# FastAPI 服务绑定配置
# 生产环境默认绑定 127.0.0.1（仅本机回环），开发环境默认绑定 :: （所有接口）
# 可通过 FASTAPI_HOST 显式覆盖；APP_ENV=prod 时回退默认值为 127.0.0.1
APP_ENV=prod
FASTAPI_HOST=127.0.0.1