[run]
source = fastapi_app
omit = 
    */tests/*
    */migrations/*
    */__pycache__/*
    */site-packages/*
    */dist-packages/*
    */venv/*
    */env/*
    */.trae/*
    */scripts/*
    */frontend/*
    # 已实现但生产导入图不可达的待接线特性；接线后必须移除本排除项。
    */services/purchase_order_spare.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
