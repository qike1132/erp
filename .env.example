# ============================================================
# ERP System - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ⚠️ 真实密钥不得提交到版本控制！
# ============================================================

# 数据库类型：postgresql（默认）
DB_TYPE=postgresql

# PostgreSQL 配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_app
DB_PASSWORD=          # 必填：生成强密码，如 python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_NAME=erp_system

# PostgreSQL 超级用户（postgres 角色）口令：仅人工运维使用（建库 / 建角色 / 手工 psql）。
# ⚠️ 应用代码【从不读取】本键（ast 全仓扫描：fastapi_app/** 零消费方）。
#    改它不会改变应用的数据库凭据 —— 应用用的是上面的 DB_USER / DB_PASSWORD。
# 轮换步骤：docs/ops/2026-09-30-credential-rotation-runbook.md §2.1（S1）
PG_SUPER_PASSWORD=

# 连接池配置 —— ⚠️ 池大小没有独立开关，真实来源是
#   fastapi_app/core/database.py::_get_pool_config() 按「UVICORN_WORKERS × DB_MAX_CONNECTIONS」
#   推导（DB_MAX_CONNECTIONS 见下方说明）：
#       available    = DB_MAX_CONNECTIONS(默认100) - 20   # 留 20 给 ARQ/迁移/管理工具
#       pool_size    = max(5, available // (workers * 2))
#       max_overflow = max(3, available // (workers * 3))
#   想调池子请改 UVICORN_WORKERS 或 DB_MAX_CONNECTIONS；
#   历史遗留的 DB_POOL_SIZE / DB_MAX_OVERFLOW 生产代码从不读取，已删（2026-10-01 P0-10）。
DB_POOL_TIMEOUT=30
# 连接最长存活秒数：由 _get_pool_config() 读取并传给 SQLAlchemy pool_recycle；
# 必须 < 服务器 idle_session_timeout（现 30min），否则池中连接被服务器杀掉后仍被取用。
# 不设置即为默认 1500。
DB_POOL_RECYCLE=1500

# PgBouncer 配置（连接池代理，部署于应用与PostgreSQL之间）
# 启用后 DB_HOST/DB_PORT 应指向 PgBouncer 而非 PostgreSQL
PGBOUNCER_ENABLED=false
PGBouncer_HOST=localhost
PGBouncer_PORT=6432

# 只读副本配置（读写分离）
# 启用后报表/列表查询将走副本，降低主库负载
# 未配置时回退到主库，无读写分离效果
ASYNC_DATABASE_REPLICA_URL=
# 示例: postgresql+asyncpg://erp_app:PASSWORD@localhost:5433/erp_system

# 显式覆盖连接串：⚠️ 若保留此键，必须填完整连接串 —— 留空（`KEY=`）会被
# pydantic-settings 读成空字符串**覆盖**下面 DB_* 的自动拼接，导致
# `Could not parse SQLAlchemy URL`（2026-10-08 新机器部署踩坑）。
# 不确定就整行删除，由 DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME 自动拼接。
# ⚠️ 两者只影响本应用：DATABASE_URL 走 psycopg3 同步驱动，供 alembic 迁移使用
#    （fastapi_app/core/config.py:303/306）
# 示例:
# ASYNC_DATABASE_URL=postgresql+asyncpg://erp_app:PASSWORD@localhost:5432/erp_system
# DATABASE_URL=postgresql+psycopg://erp_app:PASSWORD@localhost:5432/erp_system

# 数据库连接池上限基准（fastapi_app/core/database.py:34）
# pool_size / max_overflow 由此值减去 20 预留后，按 UVICORN_WORKERS 分摊推导；
# 调小 UVICORN_WORKERS 或调大本值前，先确认 PostgreSQL max_connections 能容纳。
DB_MAX_CONNECTIONS=100

# Redis 配置
# 兼容模式：未配置独立实例 URL 时，应用使用 REDIS_HOST/PORT/DB
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=       # 生产环境必填

# Redis 独立实例拆分（推荐生产环境使用）
# 缓存实例：业务缓存、限流、Session、Pub/Sub
REDIS_CACHE_URL=redis://:${REDIS_PASSWORD}@localhost:6380/0
# Celery Broker 实例
REDIS_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6381/0
# Celery Results 实例
REDIS_RESULT_URL=redis://:${REDIS_PASSWORD}@localhost:6382/0
# 保留 REDIS_URL 作为通用缓存地址的兼容入口
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6380/0

# Redis Sentinel 高可用（fastapi_app/core/config.py:322）
# 逗号分隔的 sentinel host:port 列表；留空则直连上面的 REDIS_HOST/PORT。
# 配置后由 fastapi_app/core/redis_wrapper.py:306/360 走 Sentinel 模式。
REDIS_SENTINEL_HOSTS=

# 接口限流开关（默认开启）
# ⚠️ 设为 false 会**同时**让各端点的 @limiter.limit 装饰器失效
#   （登录 100/min、导出/报表/库存导出 100/min 等），仅建议排障时临时关闭。
# 限流键：已登录按 user_id、未登录按 IP —— 内网多用户共享出口 IP 不会互相拖累。
# RATE_LIMIT_ENABLED=true
#
# 全局默认限流（默认**不设**）：留空表示只对显式标注 @limiter.limit 的端点限流。
# 原设计值 60/minute 长期被 RATE_LIMIT_ENABLED=false 架空、从未在真实流量下验证，
# 按用户计 60 次/分钟有误伤正常浏览的风险，故默认不启用。
# 想启用请先观察一段时间，再逐步收紧，例如：
# RATE_LIMIT_DEFAULT=300/minute

# 对象存储配置（P2-1）
# STORAGE_TYPE=local 保持本地 static/uploads；=s3 时上传到 MinIO/S3
STORAGE_TYPE=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=erp-uploads
# ⚠️ 占位符，勿沿用（minioadmin/minioadmin 是 MinIO 出厂默认口令，
#    2026-09-17 审计 M7）。生产必须替换为真实凭据并由部署环境注入。
S3_ACCESS_KEY=<your-access-key>
S3_SECRET_KEY=<your-secret-key>
S3_REGION=us-east-1
# 公开访问前缀；为空时返回 S3 预签名/内部代理 URL
S3_PUBLIC_URL=

# Flask/FastAPI 安全配置
# ⚠️ SECRET_KEY 必须通过以下命令生成，不得使用默认值：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT 配置
# 推荐生产环境使用 RS256（需配置 RSA 密钥对）
# ⚠️ 私钥不得提交到代码仓库！生产环境由 K8s Secret/环境变量挂载注入
# 生成密钥对命令：
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:4096
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=config/jwt/public.pem

# 刷新令牌有效期（天）与 Cookie 最大存活时间（秒）
# （fastapi_app/core/config.py:349/351；默认 7 天 / 86400 秒）
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_MAX_AGE=86400

# CORS 配置（⚠️ 逗号分隔**字符串**，不是 JSON 数组；字段名 BACKEND_CORS_ORIGINS）
# 生产环境必须使用 HTTPS 域名或内网私网 IP（http:// 仅放行 localhost/私网 IP），不得包含 null
CORS_ORIGINS=http://localhost:5002,http://localhost:3000

# 允许的主机名（⚠️ JSON **数组**！字段名与变量同名，pydantic 对 list 字段按 JSON 解析，
# 写成裸值或逗号串（如 `ALLOWED_HOSTS=*` / `a,b`）都会 SettingsError 导致进程起不来）
# 生产必填、禁止 *；内网用私网 IP。示例:
#     ALLOWED_HOSTS=["192.168.1.97","localhost","127.0.0.1"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# 应用环境
APP_ENV=development
FASTAPI_DEBUG=false

# 生产模式 Uvicorn worker 数（8GB 内存默认 4；内存紧张可调 2）
# 影响数据库连接池分摊（fastapi_app/core/database.py 会按此值计算 pool_size）
UVICORN_WORKERS=4

# 应用版本号（上报给 OpenTelemetry 的 service.version，默认 2.0.0）
APP_VERSION=2.0.0

# 出货记录查询条数上限（fastapi_app/services/purchase_plan_queries.py:35，默认 500）
PURCHASE_QUERY_LIMIT=500

# 生产配置强校验开关（S3，fastapi_app/core/config.py）
# 默认开启：生产环境若备份加密已启用但 BACKUP_ENCRYPTION_PASSWORD / BACKUP_ENCRYPTION_KEY
# 为空或仍是占位符，或 BACKUP_DIR 存在却不可写，启动直接失败
# （目的是避免"静默不加密"的备份）。仅在排障时临时置 false。
STRICT_CONFIG_CHECK=true

# 生产服务启动依赖（server_manager 安装 NSSM 服务时的 DependOnService）
# 默认自动扫描本机正在运行的 PostgreSQL/Redis 服务（名称含 postgres/redis/memurai
# 且开机自启；只读副本与已停用旧实例自动排除）
# PG/Redis 装在远端或需自定义时，用本变量显式指定（逗号/分号分隔）
# SERVICE_DEPENDS_ON=postgresql-x64-18,erp-redis

# prod_runner 日志轮转阈值（MB）：子进程 .out.log 与 Nginx access/error 日志
# 超过即 copytruncate 轮转（保留一代 .1 副本），防止磁盘被日志占满
PROD_LOG_ROTATE_MB=50

# 慢查询监控阈值（秒）
SLOW_QUERY_THRESHOLD=0.2        # OLTP 查询阈值
SLOW_QUERY_REPORT_THRESHOLD=1.0 # 报表/统计查询阈值
SLOW_QUERY_PROBE_THRESHOLD=1.0  # 基础设施健康探针（catalog/权限存在性检查）阈值

# L1 进程缓存跨 worker 失效广播（Redis Pub/Sub）
# 多 worker 生产环境（UVICORN_WORKERS>=2）建议开启：
# 任一 worker 失效缓存时同步清理其他 worker 的 L1，消除最长 local_ttl 的脏数据窗口。
# 单 worker 或开发环境保持 false（省一个 Redis 连接）。
CACHE_L1_BROADCAST_ENABLED=false

# 请求体大小上限（字节，fastapi_app/core/middleware.py:48-49；默认 512MB / 64MB）
MAX_BACKUP_UPLOAD_BYTES=536870912
MAX_IMPORT_UPLOAD_BYTES=67108864

# 开发环境额外放行的 CORS 来源（逗号分隔；生产不生效，fastapi_app/core/middleware.py:168）
DEV_CORS_ORIGINS=

# WebSocket 允许的来源（逗号分隔；留空则回退到 CORS 规则，fastapi_app/core/middleware.py:271）
WS_ALLOWED_ORIGINS=

# /static/uploads/ 签名 URL 密钥（fastapi_app/services/signed_urls.py:34 读取；与 nginx secure_link_md5 对齐）。
# 留空 = 禁用签名 URL 签发（sign_upload_url 原样返回 URL，nginx 侧相应不要启用 secure_link）。
UPLOAD_URL_SIGNING_SECRET=

# 负库存策略（P1-2 业务开关；判定入口 fastapi_app/shared/stock_concurrency.py）
# 默认 false = 拒绝任何会让库存变负的扣减/删入库（皮套出库、批量出货导入、删除皮套入库）。
# 置 true 只解除【应用层】两道闸门：统一入口预检（check_stock_available /
#   assert_stock_available）与 P1-6 的 SQL 原子守卫（UPDATE ... WHERE
#   current_stock + delta >= 0，该条件随本开关决定是否附加）。
# ⚠️ 数据库兜底约束 ck_product_current_stock_nonneg（迁移 pg_standalone_061）与本开关
#    无关：置 true 后扣成负数仍会被它拒绝（表现为 IntegrityError）。要真正允许负库存，
#    必须先手工执行一次（不可逆，执行前评估存量负库存数据）：
#        ALTER TABLE product DROP CONSTRAINT ck_product_current_stock_nonneg
# 缺省（未设置）等价于 false。
ALLOW_NEGATIVE_STOCK=false

# 库存对账 cron 开关（P1-1；读取处 fastapi_app/services/inventory_reconcile.py:is_enabled）
# 默认 false = 不注册每日 03:30 的低频对账任务；置 true 后 fastapi_app/core/arq_app.py 才注册该 cron。
# 对账只读（不写库）；缺省（未设置）等价于 false。
INVENTORY_RECONCILE_ENABLED=false

# ============================================================
# 备份系统配置
# ============================================================

# 备份目录
BACKUP_DIR=backups/server

# 备份告警配置
BACKUP_ALERT_EMAIL_ENABLED=false
BACKUP_ALERT_SMTP_HOST=smtp.gmail.com
BACKUP_ALERT_SMTP_PORT=587
BACKUP_ALERT_SMTP_USERNAME=
BACKUP_ALERT_SMTP_PASSWORD=
BACKUP_ALERT_EMAIL_FROM=
BACKUP_ALERT_EMAIL_TO=
BACKUP_ALERT_EMAIL_SUBJECT_PREFIX=[ERP Backup Alert]

BACKUP_ALERT_WEBHOOK_ENABLED=false
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_WEBHOOK_HEADERS={"Content-Type": "application/json"}

BACKUP_ALERT_FAILURE_THRESHOLD=3
BACKUP_ALERT_CRITICAL_THRESHOLD=5
BACKUP_ALERT_COOLDOWN_MINUTES=30
BACKUP_ALERT_MAX_RETRIES=3
BACKUP_ALERT_RETRY_DELAY_BASE=2

# 健康检查配置
BACKUP_DISK_SPACE_THRESHOLD=10.0
BACKUP_AGE_THRESHOLD=24
BACKUP_INTEGRITY_SAMPLE_RATE=10.0
# 恢复演练频率（天）统一在下方"灾难恢复测试配置"节声明，此处不再重复
BACKUP_HEALTH_CHECK_INTERVAL=60
BACKUP_REPORT_RETENTION_DAYS=30

# 备份策略配置
BACKUP_FULL_CRON=0 2 * * *
BACKUP_INCREMENTAL_CRON=0 */1 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=100
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_ALGORITHM=AES256
BACKUP_ENCRYPTION_KEY_PATH=
# 备份加密口令：加密备份的密钥来源（优先级：显式 password 参数 > X-Backup-Password 头 > 本键）。
# ⚠️ 若 BACKUP_ENCRYPTION_ENABLED=true 而本键为空，备份会【静默降级为不加密】，
#    且不会退回随机密钥（BACKUP_ENCRYPTION_FALLBACK_TO_GENERATED 默认 false）。生产严禁留空。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"（32+ 字符）
# 轮换 = 旧加密备份永久不可解：换值前先按 §2.3 处置存量备份。
# 轮换步骤：docs/ops/2026-09-30-credential-rotation-runbook.md §2.3（S3）
BACKUP_ENCRYPTION_PASSWORD=

# 主密钥（可选，与上面的口令二选一；两者都填时以 BACKUP_ENCRYPTION_PASSWORD 为准）
BACKUP_ENCRYPTION_KEY=
# 分片加密大文件（默认 true）与阈值、分片数上限
# （fastapi_app/services/backup/_constants.py:56-60）
BACKUP_ENCRYPTION_CHUNKED=true
BACKUP_CHUNK_SIZE=104857600
BACKUP_MAX_CHUNKS=100
# ⚠️ 必须保持 false：置 true 时若加密口令缺失会回退到【随机生成的密钥】，
#    备份当场"成功"但事后永久无法解密（P0-1 事故根因）。
BACKUP_ENCRYPTION_FALLBACK_TO_GENERATED=false
BACKUP_COMPRESSION_LEVEL=6
BACKUP_STORAGE_LOCATION=backups/server

# 单次备份/恢复操作超时（秒，fastapi_app/services/backup/_constants.py:22，默认 1800）
BACKUP_OPERATION_TIMEOUT=1800
# 打包时额外排除的文件/目录（逗号分隔；默认空，services/backup/_constants.py:114）
BACKUP_EXCLUDE_FILES=
# PostgreSQL 客户端工具目录（pg_dump / pg_restore / psql）；留空则用 PATH，
# 找不到时会降级为 JSON 导出（fastapi_app/services/backup/dump.py:38）
PG_TOOLS_BIN=
# Meilisearch（备份/恢复时同步索引，services/backup/orchestration/core.py:372-389）
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
BACKUP_PRE_CHECK=true
BACKUP_POST_VALIDATION=true
BACKUP_PARALLEL=false
BACKUP_MAX_PARALLEL_JOBS=2
BACKUP_NOTIFY_SUCCESS=false
BACKUP_NOTIFY_FAILURE=true
BACKUP_NOTIFY_WARNING=true

# 性能监控配置
BACKUP_METRICS_INTERVAL=60
BACKUP_METRICS_RETENTION_DAYS=90
BACKUP_DURATION_THRESHOLD=1800
BACKUP_SIZE_THRESHOLD=1073741824
BACKUP_CPU_THRESHOLD=80.0
BACKUP_MEMORY_THRESHOLD=80.0
BACKUP_DISK_IO_THRESHOLD=100
BACKUP_TREND_WINDOW=24
BACKUP_SUCCESS_RATE_THRESHOLD=95.0
BACKUP_FAILURE_COUNT_THRESHOLD=3

# 智能清理配置
BACKUP_SMART_CLEANUP=true
BACKUP_KEEP_MANUAL=true
BACKUP_KEEP_FAILED=false
BACKUP_MIN_FREE_SPACE_GB=10.0
BACKUP_TEST_BEFORE_DELETE=false
BACKUP_TEST_SAMPLE_RATE=10.0
BACKUP_NOTIFY_CLEANUP=true
BACKUP_CLEANUP_REPORT_DAYS=7

# 灾难恢复测试配置
BACKUP_RECOVERY_TEST_FREQUENCY=7
BACKUP_TEST_DB_HOST=localhost
BACKUP_TEST_DB_PORT=5432
BACKUP_TEST_DB_NAME=erp_backup_test
BACKUP_TEST_DB_USER=postgres
BACKUP_TEST_DB_PASSWORD=

# 恢复演练用的备份解密口令；留空则无法还原加密包
# （services/backup/orchestration/recovery_test_service.py:45/343 会抛 ValueError）
BACKUP_TEST_PASSWORD=
BACKUP_TEST_SAMPLE_SIZE=100
BACKUP_TEST_TIMEOUT_MINUTES=30
BACKUP_CLEANUP_TEST_DB=true
BACKUP_VALIDATE_INTEGRITY=true
BACKUP_VALIDATE_SCHEMA=true
BACKUP_VALIDATE_CONSTRAINTS=true
BACKUP_NOTIFY_TEST_SUCCESS=true
BACKUP_NOTIFY_TEST_FAILURE=true
BACKUP_TEST_REPORT_RETENTION_DAYS=30

# Gzip 响应压缩开关（生产默认启用；置 1 可临时禁用排查压缩相关问题）
# APP_GZIP_DISABLED=1

# ==================== 可观测性（OpenTelemetry / Sentry）====================
# ⚠️ config/otel-collector.yaml 未接线（仓库内没有 collector 运行体），
#    开启前先确认 OTEL_EXPORTER_OTLP_ENDPOINT 真的可达，否则只会往日志里刷连接错误。
# 生产环境默认启用 OTel、开发环境默认关闭（fastapi_app/core/telemetry.py:25-27）。
OTEL_ENABLED=false
OTEL_SERVICE_NAME=binfa-erp
OTEL_EXPORTER_TYPE=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry 错误上报（留空 = 完全关闭，fastapi_app/main.py:49-57）
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.1

# /metrics Bearer Token（生产必填，否则 /metrics 返回 503 fail-closed）
METRICS_BEARER_TOKEN=

# ==================== 运行看门狗（scripts/ops/watchdog.py，S2 可观测性）====================
# 由 Windows 计划任务每 5 分钟调用；检查后端/就绪/ARQ/Web 入口/备份新鲜度/磁盘剩余空间。
WATCHDOG_BACKEND_URL=http://127.0.0.1:5002
WATCHDOG_WEB_URL=http://127.0.0.1:3000
WATCHDOG_BACKUP_MAX_AGE_MINUTES=90
WATCHDOG_ALERT_COOLDOWN_MINUTES=30
WATCHDOG_TIMEOUT_SECONDS=10
# 生产部署（NSSM 服务形态）下置 true，才会把 5 个服务必须 RUNNING 当作硬要求；
# 本机以 dev 形态（vite dev server + 手工 uvicorn）运行时保持 false，避免误报。
WATCHDOG_EXPECT_SERVICES=false
WATCHDOG_SERVICES=erp-web,erp-prod,erp-arq,erp-redis,erp-redis-broker

# 看门狗额外参数（scripts/ops/watchdog.py）
# 备份目录留空则沿用 BACKUP_DIR；磁盘下限取本值、BACKUP_MIN_FREE_SPACE_GB、20 三者最大值
WATCHDOG_BACKUP_DIR=
WATCHDOG_MIN_FREE_SPACE_GB=20
WATCHDOG_STATE_FILE=logs/watchdog_state.json
WATCHDOG_LOG_FILE=logs/watchdog.log

