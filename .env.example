# ============================================================
# ERP System - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ⚠️ 真实密钥不得提交到版本控制！
# ============================================================

# 数据库类型：postgresql（默认）
DB_TYPE=postgresql

# PostgreSQL 配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_app
DB_PASSWORD=          # 必填：生成强密码，如 python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_NAME=erp_system

# 连接池配置
DB_POOL_SIZE=12
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_MAX_OVERFLOW=5

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=       # 生产环境必填

# Flask/FastAPI 安全配置
# ⚠️ SECRET_KEY 必须通过以下命令生成，不得使用默认值：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT 配置
# 推荐生产环境使用 RS256（需配置 RSA 密钥对）
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=config/jwt/public.pem

# CORS 配置（逗号分隔，生产环境必须使用 HTTPS 域名）
CORS_ORIGINS=http://localhost:5002,http://localhost:3000

# 允许的主机名（生产环境必须设置为具体域名，禁止使用 *）
ALLOWED_HOSTS=*

# 应用环境
APP_ENV=development
FASTAPI_DEBUG=false
