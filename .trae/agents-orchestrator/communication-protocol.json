{
  "version": "3.0.0",
  "name": "Agent Communication Protocol",
  "description": "Standardized communication protocol for agent interactions",
  "lastUpdated": "2026-03-28T10:00:00Z",

  "messageTypes": {
    "task_request": {
      "structure": {
        "type": "task_request",
        "requestId": "string",
        "timestamp": "ISO8601",
        "from": "agent_name",
        "to": "agent_name|array",
        "task": {
          "type": "string",
          "description": "string",
          "priority": "critical|high|medium|low",
          "deadline": "ISO8601|null",
          "requirements": "object",
          "context": "object"
        },
        "callbackUrl": "string|null"
      },
      "requiredFields": ["requestId", "timestamp", "from", "to", "task"]
    },

    "task_response": {
      "structure": {
        "type": "task_response",
        "requestId": "string",
        "timestamp": "ISO8601",
        "from": "agent_name",
        "to": "agent_name",
        "status": "success|failure|partial|timeout",
        "result": "object|null",
        "error": {
          "code": "string",
          "message": "string",
          "details": "object|null"
        }|null,
        "metadata": {
          "processingTime": "number",
          "tokensUsed": "number|null",
          "confidence": "number|null"
        }
      },
      "requiredFields": ["requestId", "timestamp", "from", "to", "status"]
    },

    "context_share": {
      "structure": {
        "type": "context_share",
        "requestId": "string",
        "timestamp": "ISO8601",
        "from": "agent_name",
        "to": "agent_name|array",
        "context": {
          "projectId": "string",
          "phase": "string",
          "data": "object",
          "history": "array"
        },
        "persist": "boolean"
      },
      "requiredFields": ["requestId", "timestamp", "from", "to", "context"]
    },

    "status_update": {
      "structure": {
        "type": "status_update",
        "requestId": "string",
        "timestamp": "ISO8601",
        "from": "agent_name",
        "status": "pending|in_progress|completed|failed|blocked",
        "progress": "number",
        "message": "string",
        "eta": "ISO8601|null"
      },
      "requiredFields": ["requestId", "timestamp", "from", "status", "progress"]
    },

    "quality_gate": {
      "structure": {
        "type": "quality_gate",
        "requestId": "string",
        "timestamp": "ISO8601",
        "gateName": "string",
        "passed": "boolean",
        "checks": [
          {
            "name": "string",
            "passed": "boolean",
            "evidence": "string",
            "details": "object|null"
          }
        ],
        "recommendations": "array|null",
        "nextAction": "proceed|retry|escalate|abort"
      },
      "requiredFields": ["requestId", "timestamp", "gateName", "passed", "checks", "nextAction"]
    },

    "escalation": {
      "structure": {
        "type": "escalation",
        "requestId": "string",
        "timestamp": "ISO8601",
        "from": "agent_name",
        "reason": "string",
        "severity": "warning|error|critical",
        "context": "object",
        "suggestedActions": "array|null"
      },
      "requiredFields": ["requestId", "timestamp", "from", "reason", "severity"]
    }
  },

  "stateManagement": {
    "states": {
      "idle": {
        "description": "Agent is waiting for tasks",
        "transitions": ["initializing", "processing"]
      },
      "initializing": {
        "description": "Agent is initializing and loading dependencies",
        "transitions": ["idle", "error"]
      },
      "processing": {
        "description": "Agent is actively processing a task",
        "transitions": ["completed", "failed", "blocked"]
      },
      "completed": {
        "description": "Task completed successfully",
        "transitions": ["idle"]
      },
      "failed": {
        "description": "Task failed, may retry",
        "transitions": ["processing", "idle", "error"]
      },
      "blocked": {
        "description": "Task is blocked waiting for dependencies",
        "transitions": ["processing", "failed", "idle"]
      },
      "error": {
        "description": "Fatal error, requires intervention",
        "transitions": ["idle"]
      }
    },

    "statePersistence": {
      "enabled": true,
      "storage": "local",
      "ttl": 86400000,
      "checkpointInterval": 30000
    }
  },

  "errorHandling": {
    "errorCategories": {
      "validation_error": {
        "severity": "warning",
        "retryable": false,
        "defaultAction": "reject_task"
      },
      "execution_error": {
        "severity": "