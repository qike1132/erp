{
  "version": "2.0.0",
  "name": "Skill Hot Reload Configuration",
  "description": "Dynamic skill loading and hot reload system",
  
  "enabled": true,
  
  "watcher": {
    "watchDirectories": [
      ".trae/",
      "skills/",
      ".trae/skills/"
    ],
    "ignoredPatterns": [
      "*.log",
      "*.tmp",
      "*.bak",
      ".git/",
      "node_modules/",
      "__pycache__/",
      ".DS_Store"
    ],
    "debounceMs": 500,
    "pollingInterval": 1000,
    "usePolling": false
  },
  
  "hotReload": {
    "enabled": true,
    "autoReload": true,
    "reloadOnChange": true,
    "preserveState": true,
    "gracefulShutdown": true,
    "shutdownTimeout": 5000
  },
  
  "skillDiscovery": {
    "autoDiscover": true,
    "discoveryDepth": 3,
    "supportedExtensions": [".md", ".json", ".ts", ".js", ".py"],
    "metadataFiles": ["SKILL.md", "_meta.json", "skill.json"],
    "validationRequired": true
  },
  
  "dependencyManagement": {
    "autoResolve": true,
    "checkCircularDependencies": true,
    "loadOrder": "topological",
    "failOnError": false,
    "fallbackToDefault": true
  },
  
  "versionControl": {
    "trackVersions": true,
    "maxVersions": 10,
    "enableRollback": true,
    "rollbackTimeout": 300000
  },
  
  "events": {
    "onLoad": {
      "notify": true,
      "log": true,
      "validate": true
    },
    "onUnload": {
      "notify": true,
      "log": true,
      "cleanup": true
    },
    "onChange": {
      "notify": true,
      "log": true,
      "reload": true
    },
    "onError": {
      "notify": true,
      "log": true,
      "fallback": true
    }
  },
  
  "performance": {
    "cacheLoadedSkills": true,
    "cacheTTL": 300000,
    "preloadCommonSkills": true,
    "lazyLoadRareSkills": true,
    "memoryLimitMB": 512
  }
}
