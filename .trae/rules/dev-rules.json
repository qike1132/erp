{
  "version": "2.0.0",
  "name": "ERP System Development Rules",
  "description": "全局开发规则配置 - 自动化代理调用系统",
  
  "globalRules": {
    "enabled": true,
    "autoActivate": true,
    "priority": "high"
  },

  "agents": {
    "frontend-developer": {
      "enabled": true,
      "autoActivate": true,
      "triggers": {
        "fileTypes": [".js", ".jsx", ".ts", ".tsx", ".vue", ".html", ".css", ".scss", ".less"],
        "events": ["onFileSave", "onFileCreate", "onCodeChange"],
        "keywords": ["前端", "UI", "组件", "页面", "样式", "React", "Vue", "Angular"]
      },
      "rules": {
        "codeQuality": true,
        "performance": true,
        "accessibility": true,
        "bestPractices": true
      },
      "autoActions": {
        "onSave": ["lint", "format", "accessibilityCheck"],
        "onCommit": ["review", "test"]
      }
    },
    
    "backend-architect": {
      "enabled": true,
      "autoActivate": true,
      "triggers": {
        "fileTypes": [".py", ".java", ".go", ".rb", ".php", ".cs", ".rs"],
        "events": ["onFileSave", "onFileCreate", "onAPIChange"],
        "keywords": ["后端", "API", "数据库", "服务", "架构", "接口"]
      },
      "rules": {
        "security": true,
        "performance": true,
        "scalability": true,
        "apiDesign": true
      },
      "autoActions": {
        "onSave": ["lint", "securityCheck"],
        "onCommit": ["review", "test", "securityAudit"]
      }
    },
    
    "ui-designer": {
      "enabled": true,
      "autoActivate": true,
      "triggers": {
        "fileTypes": [".css", ".scss", ".less", ".html", ".vue", ".jsx", ".tsx"],
        "events": ["onFileSave", "onStyleChange"],
        "keywords": ["设计", "样式", "UI", "主题", "颜色", "布局", "响应式"]
      },
      "rules": {
        "designSystem": true,
        "accessibility": true,
        "responsiveDesign": true,
        "performanceOptimization": true
      },
      "autoActions": {
        "onSave": ["stylelint", "accessibilityCheck"],
        "onCommit": ["designReview"]
      }
    },
    
    "code-reviewer": {
      "enabled": true,
      "autoActivate": true,
      "triggers": {
        "fileTypes": [".py", ".js", ".jsx", ".ts", ".tsx", ".java", ".go", ".rb", ".php"],
        "events": ["onPreCommit", "onPullRequest", "onManualTrigger"],
        "keywords": ["审查", "review", "检查", "优化", "重构"]
      },
      "rules": {
        "securityReview": true,
        "performanceReview": true,
        "codeQuality": true,
        "bestPractices": true
      },
      "autoActions": {
        "onPreCommit": ["fullReview"],
        "onPullRequest": ["fullReview", "securityAudit"]
      }
    },
    
    "security-engineer": {
      "enabled": true,
      "autoActivate": true,
      "triggers": {
        "fileTypes": [".py", ".js", ".jsx", ".ts", ".tsx", ".java", ".go", ".sql"],
        "events": ["onPreCommit", "onSecuritySensitiveChange"],
        "keywords": ["安全", "认证", "授权", "加密", "漏洞", "SQL", "XSS"]
      },
      "rules": {
        "owaspTop10": true,
        "inputValidation": true,
        "authenticationCheck": true,
        "dataProtection": true
      },
      "autoActions": {
        "onPreCommit": ["securityScan"],
        "onSecuritySensitiveChange": ["fullSecurityAudit"]
      }
    },
    
    "database-optimizer": {
      "enabled": true,
      "autoActivate": true,
      "triggers": {
        "fileTypes": [".sql", ".py", ".prisma", ".schema"],
        "events": ["onQueryChange", "onSchemaChange"],
        "keywords": ["数据库", "SQL", "查询", "索引", "优化", "性能"]
      },
      "rules": {
        "queryOptimization": true,
        "indexAnalysis": true,
        "schemaValidation": true
      },
      "autoActions": {
        "onQueryChange": ["queryAnalysis"],
        "onSchemaChange": ["schemaReview"]
      }
    }
  },

  "automationRules": {
    "onFileSave": {
      "enabled": true,
      "delay": 500,
      "actions": {
        "frontend": ["lint", "format", "typeCheck"],
        "backend": ["lint", "typeCheck", "securityScan"],
        "styles": ["stylelint", "accessibilityCheck"]
      }
    },
    
    "onPreCommit": {
      "enabled": true,
      "actions": {
        "all": ["codeReview", "securityCheck", "test"],
        "frontend": ["accessibilityCheck", "performanceCheck"],
        "backend": ["apiValidation", "securityAudit"]
      }
    },
    
    "onPullRequest": {
      "enabled": true,
      "actions": {
        "all": ["fullReview", "securityAudit", "performanceTest"]
      }
    },
    
    "onFileCreate": {
      "enabled": true,
      "templates": {
        ".py": "python-module-template",
        ".js": "javascript-module-template",
        ".tsx": "react-component-template",
        ".vue": "vue-component-template",
        ".html": "html-page-template"
      }
    }
  },

  "fileTypeMapping": {
    "frontend": {
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".vue", ".html", ".css", ".scss", ".less"],
      "primaryAgent": "frontend-developer",
      "secondaryAgents": ["ui-designer", "code-reviewer"]
    },
    "backend": {
      "extensions": [".py", ".java", ".go", ".rb", ".php", ".cs", ".rs"],
      "primaryAgent": "backend-architect",
      "secondaryAgents": ["security-engineer", "code-reviewer"]
    },
    "styles": {
      "extensions": [".css", ".scss", ".less", ".sass"],
      "primaryAgent": "ui-designer",
      "secondaryAgents": ["frontend-developer"]
    },
    "database": {
      "extensions": [".sql", ".prisma", ".schema"],
      "primaryAgent": "database-optimizer",
      "secondaryAgents": ["backend-architect"]
    },
    "config": {
      "extensions": [".json", ".yaml", ".yml", ".toml", ".env"],
      "primaryAgent": "backend-architect",
      "secondaryAgents": ["security-engineer"]
    }
  },

  "notificationSettings": {
    "enabled": true,
    "channels": ["ide", "console"],
    "levels": {
      "info": true,
      "warning": true,
      "error": true,
      "success": true
    },
    "showAgentActivation": true,
    "showRuleExecution": true,
    "showAutoActionResult": true
  },

  "performanceSettings": {
    "maxConcurrentAgents": 3,
    "timeout": 30000,
    "cacheResults": true,
    "cacheTTL": 300
  }
}
