# ============================================
# Redis for Windows 生产环境配置
# ============================================

# --------------------------------------------
# 网络配置
# --------------------------------------------

# 绑定IP地址 - 原生部署使用127.0.0.1
bind 127.0.0.1

# 监听端口
port 6379

# 保护模式
protected-mode yes

# TCP连接配置
tcp-keepalive 300
tcp-backlog 511
timeout 0

# --------------------------------------------
# 通用配置
# --------------------------------------------

# 日志级别
loglevel notice

# 日志文件位置：置空 —— Windows 服务下 redis 的 stdout 不可用，
# 日志交给 NSSM 捕获（写死相对路径的 redis.log 会在服务的工作目录里乱落）
logfile ""

# 数据库数量
databases 16

# --------------------------------------------
# 快照持久化（RDB）
# --------------------------------------------

# RDB快照规则
save 900 1
save 300 10
save 60 10000

# RDB文件名
dbfilename "dump.rdb"

# 数据目录
dir "C:\\Redis"

# RDB压缩和校验
rdbcompression yes
rdbchecksum yes

# RDB写入失败时停止写入
stop-writes-on-bgsave-error yes

# --------------------------------------------
# AOF持久化
# --------------------------------------------

# 启用AOF
appendonly yes

# AOF文件名
appendfilename "appendonly.aof"

# AOF同步策略 - 每秒同步一次
appendfsync everysec

# AOF重写配置
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# AOF文件损坏时继续加载
aof-load-truncated yes

# --------------------------------------------
# 内存管理
# --------------------------------------------

# 最大内存限制 - 512MB (ERP缓存数据量有限, 16GB双用途机器不宜占2GB)
maxmemory 512mb

# 内存淘汰策略 - LRU算法
maxmemory-policy allkeys-lru

# 内存淘汰样本数量
maxmemory-samples 5

# --------------------------------------------
# 安全配置
# --------------------------------------------

# 访问密码：从环境变量 REDIS_PASSWORD 注入，禁止在此硬编码
# 部署时通过 redis-server --requirepass "$REDIS_PASSWORD" 或 sed 渲染模板注入
# 本文件仅作为配置模板提交，真实密码不得入库
# requirepass <由 REDIS_PASSWORD 环境变量在部署时注入>

# --------------------------------------------
# 客户端配置
# --------------------------------------------

# 最大客户端连接数
maxclients 10000

# 客户端输出缓冲区限制
client-output-buffer-limit normal 0 0 0
client-output-buffer-limit replica 256mb 64mb 60
client-output-buffer-limit pubsub 32mb 8mb 60

# --------------------------------------------
# 慢查询日志
# --------------------------------------------

# 慢查询日志长度
slowlog-max-len 128

# 慢查询阈值（微秒）
slowlog-log-slower-than 10000

# --------------------------------------------
# 数据结构优化
# --------------------------------------------

# Hash优化
hash-max-ziplist-entries 512
hash-max-ziplist-value 64

# List优化
list-max-ziplist-size -2
list-compress-depth 0

# Set优化
set-max-intset-entries 512

# Sorted Set优化
zset-max-ziplist-entries 128
zset-max-ziplist-value 64

# HyperLogLog优化
hll-sparse-max-bytes 3000

# Lua脚本执行时间限制（毫秒）
lua-time-limit 5000
# Generated by CONFIG REWRITE
# ⚠️ 下一行原为 redis CONFIG REWRITE 落下的生效指令 + 占位口令，直接复制模板会让
#    redis 用占位符当口令（或解析失败）。口令只经 NSSM 的 --requirepass 注入，故注释掉。
# requirepass <由 REDIS_PASSWORD 环境变量在部署时注入>
