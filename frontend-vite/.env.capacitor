# Capacitor 移动端构建环境
# API 使用完整内网地址（APK中无Vite proxy，必须指向后端）
VITE_CAPACITOR=1
VITE_API_BASE_URL=http://192.168.0.95:5002/api/v1
VITE_WS_BASE_URL=ws://192.168.0.95:5002
VITE_STATIC_ORIGIN=http://192.168.0.95:5002
# 与 .env.development / .env.production 命名对齐，供 capacitor.config.ts 与运行时引用
VITE_API_URL=http://192.168.0.95:5002
VITE_WS_URL=ws://192.168.0.95:5002
VITE_APP_VERSION=1.0.0
