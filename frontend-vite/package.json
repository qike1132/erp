{
  "name": "binfa-erp-vue3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "build:fast": "vite build --logLevel info",
    "build:open": "node scripts/build-refresh.mjs",
    "build:open:fast": "node scripts/build-refresh.mjs --fast",
    "check:routes": "node scripts/check-route-alignment.mjs",
    "check:api": "node scripts/check-api-alignment.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.vue",
    "lint:fix": "eslint src/ --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "build:cap": "vue-tsc -b && vite build --mode capacitor && node -e \"const fs=require('fs'),p=require('path');['sw.js','workbox-63c18b4d.js','registerSW.js','manifest.webmanifest'].forEach(f=>{try{fs.unlinkSync('dist/'+f)}catch(e){}});const html='dist/index.html';let c=fs.readFileSync(html,'utf8');c=c.replace(/<script[^>]*registerSW[^>]*><\\/script>/g,'');fs.writeFileSync(html,c)\"",
    "cap:patch": "node -e \"const f='node_modules/@capacitor/filesystem/android/build.gradle';const fs=require('fs');if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');c=c.replace(/JavaVersion.VERSION_21/g,'JavaVersion.VERSION_17').replace(/jvmToolchain\\(21\\)/g,'jvmToolchain(17)');fs.writeFileSync(f,c);console.log('Patched filesystem plugin to JDK 17')}\"",
    "cap:sync": "npm run cap:patch && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build:cap && npm run cap:sync && cd android && set JAVA_HOME=C:\\\\Program Files\\\\Java\\\\jdk-17.0.13+11 && set ANDROID_SDK_ROOT= && gradlew assembleDebug --no-daemon"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.1.0",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.33.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  },
  "dependencies": {
    "@babel/traverse": "^8.0.4",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@sentry/vue": "^10.56.0",
    "@tanstack/query-persist-client-core": "^5.100.10",
    "@tanstack/query-sync-storage-persister": "^5.100.10",
    "@tanstack/vue-query": "^5.100.10",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "reka-ui": "^2.9.7",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "web-vitals": "^5.2.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "js-cookie": "^3.0.8",
    "form-data": "^4.0.6",
    "ws": "^8.21.0"
  }
}
