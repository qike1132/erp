{
  "name": "binfa-erp-vue3",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vue-tsc -b && vite build",
    "build:fast": "vite build --logLevel info",
    "build:atomic": "vue-tsc -b && vite build --outDir dist-new --logLevel info && node scripts/swap-dist.mjs",
    "build:open": "node scripts/build-refresh.mjs",
    "build:open:fast": "node scripts/build-refresh.mjs --fast",
    "check:routes": "node scripts/check-route-alignment.mjs",
    "check:api": "node scripts/check-api-alignment.mjs",
    "check:api:pc": "node scripts/check-pc-api-bypass.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.vue",
    "lint:fix": "eslint src/ --ext .ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/traverse": "^8.0.4",
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.1.0",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "^1.102.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.33.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@sentry/vue": "^10.56.0",
    "@tanstack/query-persist-client-core": "^5.100.10",
    "@tanstack/query-sync-storage-persister": "^5.100.10",
    "@tanstack/vue-query": "^5.100.10",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "reka-ui": "^2.9.7",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "web-vitals": "^5.2.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "js-cookie": "^3.0.8",
    "form-data": "^4.0.6",
    "ws": "^8.21.0"
  }
}
