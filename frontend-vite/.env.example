# 环境变量模板 - 复制为 .env.development 或 .env.production 使用
VITE_API_URL=http://127.0.0.1:5002
VITE_WS_URL=ws://127.0.0.1:5002

# 生产错误遥测（可选）。留空则完全不初始化 Sentry（不加载其 chunk、不发出请求）。
# 配置后会启用错误上报；cookies 与请求头已在 beforeSend 中剥离，不会外送会话凭据。
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
#
# 发版标识（可选）：用于把错误关联到具体版本，留空则 Sentry 事件不带 release。
# VITE_APP_VERSION=
