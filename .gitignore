# === 2026-09-30 凭据文件不得入库 ===
# config/pgbouncer/userlist.txt：存放 erp_app/erp_admin/erp_monitor 三个数据库账号的
#   认证口令（当前 auth_type=scram-sha-256，该模式下 userlist 存明文即可）。
#   该文件此前**既被 git 跟踪、又没有任何 ignore 规则**（git check-ignore 返回 exit 1），
#   三个账号还共用同一个 26 字符口令 —— 属实质凭据泄露，已于同日轮换。
#   保留同名 .example 模板（不含口令）继续入库。
#   注意：本规则只匹配该确切路径，不会误伤 userlist.txt.example。
/config/pgbouncer/userlist.txt

# === 2026-10-01 私钥与凭据副本不得入库（captain 补） ===
# 背景：config/tls/ 下出现 CA 与服务端**私钥**（ca.key/server.key，未忽略），
#   且工作区存在 .env.bak-pre-p010（.env 全量副本）。三者 git check-ignore 均为 exit 1，
#   任何一次 `git add -A` 都会把私钥与生产口令副本写入索引。
#   server.crt/.csr/.ext 为公开材料，继续允许入库。
/config/tls/*.key
/config/tls/*.srl
# /static/uploads 的 secure_link 签名密钥：2026-10-02 前它是明文写在
#   config/nginx-windows.conf 的 secure_link_md5 里的（且已推送远端），
#   等于把「限时签名」的密钥交给所有能读仓库的人。现改为 nginx `include` 本文件，
#   真实值只存在于本机与部署环境；仓库里保留 .example 模板。
/config/uploads-signing.conf
# .env 的备份副本（第 30 行的 `.env` 只匹配确切文件名，不覆盖 ".env.bak-*"）
.env.bak-*
.env.*.bak*
# AgentTeams 运行态目录（含任务/邮箱状态，不入库）
/.agent-teams/
# 根目录一次性排查脚本的 .ini 变体（与 /_*.py、/_*.sh、/_*.txt、/_*.json、/_*.mjs 同族）
/_*.ini

# === 2026-10-08 离线便携包：deploy/binaries 内容不入库 ===
# deploy/build_package.ps1 要求把 6 个官方安装器放进 deploy\binaries\（pg18*/Redis/nginx/nssm/node/vc_redist），
# 但它在打包前会拒绝「工作区不干净」。安装器里的 .msi/.exe 不被现有规则忽略（*.zip 已被上方 /Archive files 覆盖），
# 一旦落位就会让 `git status --porcelain` 非空 —— 文档化的构建流程因此永远跑不起来（互为死结）。
# 故按目录忽略其内容，仅保留 .gitkeep 占位，使该目录在全新克隆中即存在（预检与 README 所指的落位目录）。
/deploy/binaries/*
!/deploy/binaries/.gitkeep

# === pre-commit hook 环境缓存（2026-10-10）===
# 本机 Python 写不了 C:\Users\Administrator\.cache（ACL 拦 EACCES → SQLite "readonly database"），
# 而那是 pre-commit 的默认 PRE_COMMIT_HOME，导致第 4 层永远跑不起来。
# 故 .githooks/pre-commit 把 PRE_COMMIT_HOME 默认指到仓内该目录；纯缓存，不入库。
/.pre-commit-home/

# uv 锁门禁的仓内缓存/临时目录（scripts/check_requirements_lock.py）
.uv-cache/
.lockcheck-tmp/
